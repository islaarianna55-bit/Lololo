      "webhookId": "1c17dffe-ff49-4005-9f6e-8e2d104b5cb3"
    },
    {
      "parameters": {
        "jsCode": "// One summary for the whole run, built from the rows that were written back to the sheet.\nconst BUY = 'https://weio.ai/services/site-check-api.html?utm_source=n8n&utm_medium=templates&utm_campaign=site-enrich';\nconst s = $('Settings').first().json;\nconst all = $input.all().map(i => i.json);\nconst rows = all.filter(r => r.website !== undefined && r.website !== '');\nconst by = p => rows.filter(r => String(r.enrich_status || '').startsWith(p));\nconst found = by('enriched'), none = by('no public'), down = by('website unreachable'),\n      bad = by('not a valid'), retry = by('retry');\nlet credits = null;\ntry {   // balance reported by the most recent lookup\n  const c = $('Normalize result').last().json.credits_remaining;\n  if (typeof c === 'number') credits = c;\n} catch (e) {}\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nlet html = `<p>Looked up ${rows.length} website(s).</p><ul>` +\n  `<li>${found.length} with contact details</li>` +\n  `<li>${none.length} reachable, but no public contact details on the homepage</li>` +\n  `<li>${down.length} unreachable</li>` +\n  (bad.length ? `<li>${bad.length} not a valid website address</li>` : '') +\n  (retry.length ? `<li>${retry.length} to retry next run (not charged)</li>` : '') + '</ul>';\nif (found.length) {\n  html += '<h3>Contact details found</h3><ul>' + found.map(r => `<li><b>${esc(r.website)}</b>` +\n    (r.site_title ? ` (${esc(r.site_title)})` : '') +\n    `<br><small>${esc([r.emails, r.phones, r.contact_page].filter(Boolean).join(' | '))}</small></li>`).join('') + '</ul>';\n}\nif (all.length > rows.length) {\n  html += `<p>${all.length - rows.length} row(s) could not be written back: their website cell changed during the run.</p>`;\n}\nif (credits !== null) {\n  html += `<p>Credits left on your Weio API key: ${credits}.` +\n    (credits < Number(s.max_lookups_per_run || 0) ? ` That is less than one full run; <a href=\"${BUY}\">top up here</a>.` : '') + '</p>';\n}\nhtml += '<p><small>Sent by the lead enrichment workflow. Full results are in your sheet.</small></p>';\nreturn [{ json: {\n  looked_up: rows.length, with_contacts: found.length, no_contacts: none.length, unreachable: down.length,\n  invalid: bad.length, retry_next_run: retry.length, not_written: all.length - rows.length,\n  credits_remaining: credits, email_to: s.summary_email,\n  subject: `Lead enrichment: ${found.length} with contact details, ${none.length + down.length} without`,\n  html,\n} }];"
      },
