              "type": "number"
            },
            {
              "id": "d1000000-0000-4000-8000-000000000002",
              "name": "email",
              "value": "",
              "type": "string"
            },
            {
              "id": "d1000000-0000-4000-8000-000000000003",
              "name": "verification_status",
              "value": "={{ $json.status === 'completed' ? 'not_found' : 'find_' + ($json.status || 'error') }}",
              "type": "string"
            },
            {
              "id": "d1000000-0000-4000-8000-000000000004",
              "name": "cost_usd",
              "value": "={{ Number($json.actualCost || 0) }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Build Not Found Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
