        "method": "POST",
        "url": "https://api.apify.com/v2/acts/cce_partners~samgov-opportunity-radar/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "timeout",
              "value": "280"
