        "specifyBody": "json",
        "jsonBody": "{\n  \"naicsCodes\": [\n    \"541512\"\n  ],\n  \"setAside\": \"SBA\",\n  \"lookbackDays\": 2,\n  \"maxItems\": 25,\n  \"monitorName\": \"n8n-daily\"\n}",
