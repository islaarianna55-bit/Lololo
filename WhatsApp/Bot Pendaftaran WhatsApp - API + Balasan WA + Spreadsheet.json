 "name": "Bot Pendaftaran WhatsApp - API + Balasan WA + Spreadsheet",
 "nodes": [
  {
   "id": "12e095c6-2f35-47f0-a14a-da863f69fcb1",
   "name": "Webhook Pesan Masuk",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2.1,
   "position": [
    260,
    300
   ],
   "parameters": {
    "httpMethod": "POST",
    "path": "pendaftaran-wa-2",
