  {
   "id": "076bde1f-597c-4d57-a2f8-a59ea19bbcfa",
   "name": "Normalize Data Pendaftar",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    460,
    300
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "// Menerima payload dari wago-api webhook\n// Format: { sessionId, event, data: { id, chat, sender, pushName, timestamp, body, type, ... } }\nconst req = $input.first().json;\nconst body = req.body ?? req;\n\nlet evt = body;\nif (body.data) evt = body.data;\n\n// Skip pesan dari diri sendiri dan group\nif (evt.isFromMe === true || evt.isGroup === true) return [];\n\n// Ambil pesan teks\nconst text = (evt.body || '').toString().trim();\nif (!text) return [];\n\n// Parsing format pendaftaran\nconst fields = {};\nconst lines = text.split(/[,\\n]/);\nfor (const line of lines) {\n  const kv = line.split(/[:=]/);\n  if (kv.length >= 2) {\n    const k = kv[0].trim().toLowerCase();\n    const v = kv.slice(1).join(':').trim();\n    fields[k] = v;\n  }\n}\n\nconst extract = (patterns) => {\n  for (const p of patterns) {\n    const m = text.match(new RegExp(p, 'i'));\n    if (m) return m[1]?.trim();\n  }\n  return undefined;\n};\n\nconst nama = fields['nama'] || fields['name'] || fields['nama lengkap'] || extract([r'Nama[:\\s]+([^,\\n]+)', r'Nama Lengkap[:\\s]+([^,\\n]+)']);\nconst alamat = fields['alamat'] || fields['address'] || extract([r'Alamat[:\\s]+([^,\\n]+)']);\nconst noHp = fields['no hp'] || fields['no. hp'] || fields['nomor hp'] || fields['phone'] || fields['hp'] || extract([r'(?:No\\.?\\s*HP|HP|Phone|Nomor)[:\\s]+(\\+?\\d[\\d\\s\\-]+)']);\nconst email = fields['email'] || fields['e-mail'] || extract([r'Email[:\\s]+([^,\\n\\s]+)']);\n\nlet hpNorm = '';\nif (noHp) {\n  let digits = noHp.replace(/\\D/g, '');\n  if (digits.startsWith('0')) digits = '62' + digits.slice(1);\n  if (!digits.startsWith('62')) digits = '62' + digits;\n  hpNorm = digits;\n}\n\nreturn [{\n  json: {\n    nama: nama || evt.pushName || 'Tidak diketahui',\n    alamat: alamat || '',\n    no_hp: hpNorm || evt.sender?.replace(/@.*/,'') || '',\n    email: email || '',\n    pesan_asli: text,\n    wa_sender: evt.sender || '',\n    wa_chat: evt.chat || '',\n    wa_pushName: evt.pushName || '',\n    wa_timestamp: evt.timestamp || new Date().toISOString(),\n    wa_messageId: evt.id || '',\n    is_valid: !!(nama && hpNorm),\n    registered_at: new Date().toISOString()\n  }\n}];"
   }
  },
