      "parameters": {
        "jsCode": "const reg = $input.first();\nconst img = $('Generate GPT Image 1').first();\nconst uploadUrl = reg.json.value.uploadUrl;\nconst imageAssetId = reg.json.value.image;\nif (!uploadUrl || !imageAssetId) throw new Error('LinkedIn upload registration failed. Check OAuth credential and Person URN.');\nreturn [{\n  json: {\n    uploadUrl,\n    imageAssetId,\n    linkedinPersonUrn: $('Business Config').first().json.linkedinPersonUrn,\n    postText: $('Generate LinkedIn Post').first().json.output[0].content[0].text,\n    selectedTopic: $('Smart Topic Selector').first().json.selectedTopic,\n    selectedAngle: $('Smart Topic Selector').first().json.selectedAngle,\n    imagePrompt: $('Generate Image Prompt').first().json.output[0].content[0].text,\n    imageUrl: \"\"\n  },\n  binary: img.binary\n}];"
      },
