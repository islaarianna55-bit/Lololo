      "id": "09d7f3bf-f38e-4801-b4f2-31b516b16e86",
      "name": "Get Post History",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -752,
        -960
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const config = $('Business Config').first().json;\nconst allRows = $input.all();\nlet contentPillars;\ntry { contentPillars = JSON.parse(config.contentPillars); }\ncatch(e) { contentPillars = [\"Industry tips\",\"Behind the scenes\",\"Client story\",\"Common mistakes\",\"Why outsource\",\"Latest trends\",\"Our services\"]; }\nconst today = new Date().toISOString().split('T')[0];\nconst todayPosts = allRows.filter(i => i.json && i.json.date === today && i.json.status === 'published');\nconst todayPostCount = todayPosts.length;\nconst maxPosts = parseInt(config.maxPostsPerDay) || 3;\nconst canPost = todayPostCount < maxPosts;\nif (!canPost) return [{ json: { ...config, canPost: false, todayPostCount, maxPostsPerDay: maxPosts } }];\nconst sortedRows = allRows.filter(i => i.json && i.json.topic).sort((a, b) => new Date(b.json.timestamp || b.json.date) - new Date(a.json.timestamp || a.json.date));\nconst recentTopics = sortedRows.slice(0, 7).map(i => i.json.topic).filter(Boolean);\nlet availableTopics = contentPillars.filter(t => !recentTopics.includes(t));\nif (availableTopics.length === 0) availableTopics = contentPillars;\nconst selectedTopic = availableTopics[Math.floor(Math.random() * availableTopics.length)];\nconst angles = [\"Share a personal story about this topic\",\"Give 5 practical actionable tips\",\"Bust a common myth about this topic\",\"Share a surprising fact or statistic\",\"Tell a client transformation story\",\"Write a thought-provoking question post\",\"Share a hard lesson learned\"];\nconst selectedAngle = angles[Math.floor(Math.random() * angles.length)];\nconst now = new Date();\nconst dayNames = [\"Sunday\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"];\nconst h = now.getHours();\nreturn [{ json: { ...config, canPost: true, todayPostCount, maxPostsPerDay: maxPosts, remainingPostsToday: maxPosts - todayPostCount, selectedTopic, selectedAngle, dayName: dayNames[now.getDay()], timeSlot: h < 12 ? \"morning\" : h < 17 ? \"afternoon\" : \"evening\", generatedAt: now.toISOString() } }];"
      },
