    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "=You are a LinkedIn content strategist writing posts for {{ $json.ownerName }}, owner of {{ $json.businessName }}, a {{ $json.businessType }} business.\nServices: {{ $json.services }}\nAudience: {{ $json.targetAudience }}\nUnique value: {{ $json.uniqueValue }}\nTone: {{ $json.tone }}\n\nLinkedIn post rules:\n1. Open with a POWERFUL hook in first 1-2 lines\n2. Write 150-250 words total\n3. Short paragraphs max 2-3 sentences each\n4. Include 3-5 bullet points OR a short story arc\n5. End with a conversational call-to-action\n6. Add exactly 5 relevant hashtags at the very end\n7. Write in first person as the business owner\n8. Sound human and authentic, never like AI\n9. NEVER use \"In the digital age\" or \"Exciting news\"\n10. Provide REAL value to the reader"
            },
            {
              "content": "=Write a LinkedIn post about: {{ $json.selectedTopic }}\n\nWriting angle: {{ $json.selectedAngle }}\n\nIt is {{ $json.dayName }} {{ $json.timeSlot }}. Write naturally for this time.\n\nYou are {{ $json.ownerName }} from {{ $json.businessName }}.\nAudience: {{ $json.targetAudience }}\nMust feel written by a real expert in {{ $json.businessType }}, not AI."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 600,
          "temperature": 0.85
        }
      },
