    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c054efa4-1a6f-4b10-b8d6-c35940546cae",
              "name": "urls",
              "value": "={{ [\n  'https://www.youtube.com/watch?v=aircAruvnKk',\n  'https://www.tiktok.com/t/ZTyXc9cpY/'\n] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "1cffdf8d-3d4d-4665-999c-eaa77b865f0c",
      "name": "Set video links",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Split the URL list by platform so each Apify Actor is called once with a batch.\nconst urls = $input.first().json.urls.map(u => String(u).trim()).filter(Boolean);\nconst isTikTok = u => /tiktok\\.com/i.test(u);\nconst out = [];\nconst youtube = urls.filter(u => !isTikTok(u));\nconst tiktok = urls.filter(isTikTok);\nif (youtube.length) out.push({ json: { platform: 'youtube', actor: 'tubetext~youtube-transcript-fast', input: { urls: youtube, aiFallback: true } } });\nif (tiktok.length) out.push({ json: { platform: 'tiktok', actor: 'tubetext~tiktok-transcript', input: { urls: tiktok } } });\nreturn out;"
      },
      "id": "aa3f2a4b-2ae6-4a37-abf2-e1340f49efb0",
      "name": "Split links by platform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/{{ $json.actor }}/run-sync-get-dataset-items?timeout=300",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.input) }}",
        "options": {
          "timeout": 310000
        }
      },
      "id": "bd45887c-9f72-4113-9b83-9299a3ff2e31",
      "name": "Get transcripts from Apify",
